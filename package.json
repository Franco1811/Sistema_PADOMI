{
	"dependencies": {
		"@types/node": "^25.7.0",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@types/selenium-webdriver": "^4.35.7",
		"concurrently": "^10.0.1",
		"selenium-webdriver": "^4.52.0"
	},
	"scripts": {
		"dev:backend": "pnpm --filter backend dev",
		"dev:frontend": "pnpm --filter frontend dev",
		"dev:functions": "pnpm --filter ingesta-biometrica-function start",
		"dev:web": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
		"dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\" \"pnpm dev:functions\"",
		"test": "pnpm --filter backend test",
		"test:backend": "pnpm --filter backend test",
		"test:depuracion": "pnpm --filter backend test:depuracion",
		"test:selenium": "ts-node -T --project tests/selenium-e2e/tsconfig.json tests/selenium-e2e/ejecutar-pruebas-selenium.ts",
		"test:jmeter": "powershell -ExecutionPolicy Bypass -File tests/jmeter/abrir-jmeter.ps1"
	}
}

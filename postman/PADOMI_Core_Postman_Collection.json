          "name": "0.1 Contexto Token Admin (Pre-condición)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Pre-condición: Token JWT de Administrador generado', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.collectionVariables.set('adminToken', jsonData.token);",
                  "    if (jsonData.usuario && jsonData.usuario.id) {",
                  "        pm.collectionVariables.set('adminId', jsonData.usuario.id);",
                  "    }",
                  "});"

    {
      "name": "04. CORE: Triaje de Emergencias y Prevención de Condición de Carrera (CU-07)",
      "item": [
        {
          "name": "CORE-11 (Verificación Motor CU-09): Confirmar Generación Automática de Alerta CRÍTICA y ADVERTENCIA",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Esperamos 1.5s para que el bus de eventos asíncrono termine de persistir en Supabase",
                  "setTimeout(function(){}, 1500);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK: Historial de alertas del paciente recuperado', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Motor de Reglas CU-09: Clasificó correctamente las lecturas en CRITICO y ADVERTENCIA', function () {",
                  "    const alertas = pm.response.json();",
                  "    pm.expect(alertas).to.be.an('array');",
                  "    pm.expect(alertas.length).to.be.at.least(2);",
                  "    const alertaCritica = alertas.find(a => a.severidad === 'CRITICO' && a.atendida === false);",
                  "    const alertaAdvertencia = alertas.find(a => a.severidad === 'ADVERTENCIA');",
                  "    pm.expect(alertaCritica, 'Debe existir la alerta CRITICO generada por 41.8 °C').to.not.be.undefined;",
                  "    pm.expect(alertaAdvertencia, 'Debe existir la alerta ADVERTENCIA generada por 37.9 °C').to.not.be.undefined;",
                  "    pm.collectionVariables.set('alertaCriticaId', alertaCritica.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{medicoToken}}"

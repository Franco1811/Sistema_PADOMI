    {
      "name": "01. CORE: Catálogo de Métricas y Umbrales Clínicos (CU-03)",
      "item": [
        {
          "name": "CORE-01 (CP-INT-13): Registrar Métrica Clínica Temperatura Corporal (36.0 - 37.5 °C)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const suffix = Math.floor(1000 + Math.random() * 9000);",
                  "pm.collectionVariables.set('nombreMetricaTemp', 'Temperatura Corporal IoT ' + suffix);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201 Created: Métrica clínica creada en catálogo', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Regla de Dominio CU-03: Genera código correlativo MET-XXXX y respeta umbral [36.0 - 37.5]', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('id');",
                  "    pm.expect(data.codigo).to.match(/^MET-\\d{4}$/);",
                  "    pm.expect(data.rangoMin).to.eql(36);",
                  "    pm.expect(data.rangoMax).to.eql(37.5);",
                  "    pm.collectionVariables.set('metricaCoreId', data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombreMetricaTemp}}\",\n  \"unidad\": \"°C\",\n  \"descripcion\": \"Temperatura corporal monitoreada por sensor IoT PADOMI\",\n  \"rangoMin\": 36.0,\n  \"rangoMax\": 37.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/metricas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metricas"
              ]
            }
          },
          "response": []
        },
        {
          "name": "CORE-02 (CP-INT-16): Bloqueo de Umbral Clínico Incoherente (rangoMin >= rangoMax - RNF-11)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 400 Bad Request: Bloquea inversión de umbrales clínicos (Min 140 >= Max 90)', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Regla Matemática RNF-11: Mensaje informa incoherencia de rango máximo vs mínimo', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('error');",
                  "    pm.expect(data.error.toLowerCase()).to.include('rango');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",

# =================================================================
# Especificación de Pruebas de API - Sistema de Telemetría PADOMI
# =================================================================

@hostname = http://localhost:3000/api

# Variables de autenticación e identificadores para pruebas manuales:
@tokenAdmin = pegue_aqui_el_token_de_admin
@tokenMedico = pegue_aqui_el_token_de_medico
@tokenEnfermero = pegue_aqui_el_token_de_enfermero

@medicoId = pegue_aqui_el_uuid_del_medico_creado
@enfermeroId = pegue_aqui_el_uuid_del_enfermero_creado
@pacienteId = pegue_aqui_el_uuid_del_paciente_creado
@metricaId = pegue_aqui_el_uuid_de_la_metrica_creada


# =================================================================
# CU-01: Iniciar Sesión (Autenticación)
# =================================================================

### 1.1 Iniciar sesión como administrador
# @name loginAdmin
POST {{hostname}}/auth/login
Content-Type: application/json

{
  "email": "admin.padomi@essalud.gob.pe",
  "password": "admin_secreto"
}

###

### 1.2 Iniciar sesión como médico
# @name loginMedico
POST {{hostname}}/auth/login
Content-Type: application/json

{
  "email": "carlos.mendoza@essalud.gob.pe",
  "password": "carlos_secreto"
}

###

### 1.3 Iniciar sesión como enfermero
# @name loginEnfermero
POST {{hostname}}/auth/login
Content-Type: application/json

{
  "email": "ana.gomez@essalud.gob.pe",
  "password": "enfermera_secreta"
}

###

### 1.4 Inicios de sesión rechazados (Validaciones de seguridad)

# Intento con contraseña incorrecta
POST {{hostname}}/auth/login
Content-Type: application/json

{
  "email": "admin.padomi@essalud.gob.pe",
  "password": "secreto_equivocado"
}

###

# Intento con email no registrado
POST {{hostname}}/auth/login
Content-Type: application/json

{
  "email": "no.existe@essalud.gob.pe",
  "password": "admin_secreto"
}

###

# Intento con contraseña de longitud menor a la requerida
POST {{hostname}}/auth/login
Content-Type: application/json

{
  "email": "admin.padomi@essalud.gob.pe",
  "password": "123"
}


# =================================================================
# CU-02: Gestionar Personal (Acceso Administrativo)
# =================================================================

### 2.1 Registrar médico como administrador
POST {{hostname}}/personal
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "dni": "88888882",
  "nombre": "Mateo",
  "apellido": "Silva",
  "email": "mateo.silva@essalud.gob.pe",
  "password": "mateo_secreto",
  "rol": "MEDICO",
  "especialidad": "Cardiología"
}

###

### 2.2 Registrar enfermero como administrador
POST {{hostname}}/personal
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "dni": "88888883",
  "nombre": "Laura",
  "apellido": "Reyes",
  "email": "laura.reyes@essalud.gob.pe",
  "password": "laura_secreta",
  "rol": "ENFERMERO"
}

###

### 2.3 Listar personal como administrador
GET {{hostname}}/personal
Authorization: Bearer {{tokenAdmin}}

###

### 2.4 Actualizar personal como administrador
PUT {{hostname}}/personal/{{medicoId}}
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "nombre": "Mateo Alberto",
  "apellido": "Silva Garcia",
  "email": "mateo.silva@essalud.gob.pe",
  "rol": "MEDICO",
  "especialidad": "Cardiología Avanzada"
}

###

### 2.5 Deshabilitar personal como administrador
DELETE {{hostname}}/personal/{{medicoId}}
Authorization: Bearer {{tokenAdmin}}

###

### 2.6 Gestiones de personal rechazadas (Validaciones de seguridad e integridad)

# Listar personal como médico (Falta de privilegios)
GET {{hostname}}/personal
Authorization: Bearer {{tokenMedico}}

###

# Crear personal como médico (Falta de privilegios)
POST {{hostname}}/personal
Content-Type: application/json
Authorization: Bearer {{tokenMedico}}

{
  "dni": "99999999",
  "nombre": "Intruso",
  "apellido": "Intruso",
  "email": "intruso@essalud.gob.pe",
  "password": "password",
  "rol": "ENFERMERO"
}

###

# Actualizacion como enfermero (Falta de privilegios)
PUT {{hostname}}/personal/{{medicoId}}
Content-Type: application/json
Authorization: Bearer {{tokenEnfermero}}

{
  "nombre": "Carlos Alberto",
  "apellido": "Mendoza Garcia",
  "email": "carlos.mendoza@essalud.gob.pe",
  "rol": "MEDICO",
  "especialidad": "Cardiología Avanzada"
}

###

# Deshabilitación como médico (Falta de privilegios)
DELETE {{hostname}}/personal/{{medicoId}}
Authorization: Bearer {{tokenMedico}}

###

# Intento con número de DNI ya registrado
POST {{hostname}}/personal
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "dni": "88888880",
  "nombre": "Repetido",
  "apellido": "Dni",
  "email": "repetido.dni@essalud.gob.pe",
  "password": "password",
  "rol": "MEDICO",
  "especialidad": "Neumología"
}

###

# Intento con formatos de datos inválidos (DNI y correo electrónico)
POST {{hostname}}/personal
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "dni": "123",
  "nombre": "Error",
  "apellido": "Formatos",
  "email": "email_invalido",
  "password": "123",
  "rol": "MEDICO",
  "especialidad": "Pediatría"
}



# =================================================================
# CU-03: Gestionar Catálogo de Métricas (Acceso Administrativo)
# =================================================================

### 3.1 Listar métricas como administrador
GET {{hostname}}/metricas
Authorization: Bearer {{tokenAdmin}}

###

### 3.2 Listar métricas como enfermero
GET {{hostname}}/metricas
Authorization: Bearer {{tokenEnfermero}}

###

### 3.3 Crear métrica como administrador
POST {{hostname}}/metricas
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "nombre": "Saturación de Oxígeno",
  "unidad": "%",
  "descripcion": "Saturación de oxígeno medida por oxímetro de pulso",
  "rangoMin": 70.0,
  "rangoMax": 100.0
}

###

### 3.4 Actualizar métrica como administrador
PUT {{hostname}}/metricas/{{metricaId}}
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "nombre": "Saturación de Oxígeno",
  "unidad": "%",
  "descripcion": "Monitoreo continuo de saturación de oxígeno",
  "rangoMin": 60.0,
  "rangoMax": 100.0
}

###

### 3.5 Eliminar métrica como administrador
DELETE {{hostname}}/metricas/{{metricaId}}
Authorization: Bearer {{tokenAdmin}}

###

### 3.6 Gestiones de métricas rechazadas (Validaciones)

# Crear métrica como médico (Falta de privilegios)
POST {{hostname}}/metricas
Content-Type: application/json
Authorization: Bearer {{tokenMedico}}

{
  "nombre": "Intento Médico",
  "unidad": "kg",
  "descripcion": "Intento de intrusión",
  "rangoMin": 10.0,
  "rangoMax": 200.0
}

###

# Actualizar métrica como enfermero (Falta de privilegios)
PUT {{hostname}}/metricas/{{metricaId}}
Content-Type: application/json
Authorization: Bearer {{tokenEnfermero}}

{
  "nombre": "Saturación de Oxígeno IoT",
  "unidad": "%",
  "descripcion": "Intento de modificación",
  "rangoMin": 60.0,
  "rangoMax": 100.0
}

###

# Eliminar métrica como médico (Falta de privilegios)
DELETE {{hostname}}/metricas/{{metricaId}}
Authorization: Bearer {{tokenMedico}}

###

# Crear métrica con rangos clínicos incoherentes
POST {{hostname}}/metricas
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "nombre": "Métrica Errónea",
  "unidad": "%",
  "descripcion": "Rango inverso",
  "rangoMin": 90.0,
  "rangoMax": 40.0
}



# =================================================================
# CU-04: Registrar Paciente Crónico (Acceso Admin o Médico)
# =================================================================

### 4.1 Registrar paciente como administrador
POST {{hostname}}/pacientes/registro
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "dni": "72223340",
  "nombres": "Gabriel Garcia Marquez",
  "edad": 80,
  "diagnostico": "Bronquitis Crónica",
  "medicoAsignadoId": "{{medicoId}}"
}

###

### 4.2 Registros de pacientes rechazados (Validaciones)

# Registro paciente como enfermero (Falta de privilegios)
POST {{hostname}}/pacientes/registro
Content-Type: application/json
Authorization: Bearer {{tokenEnfermero}}

{
  "dni": "72223334",
  "nombres": "Intento Enfermero",
  "edad": 50,
  "diagnostico": "Diabetes",
  "medicoAsignadoId": "{{medicoId}}"
}

###

# Intento con DNI de paciente ya registrado
POST {{hostname}}/pacientes/registro
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "dni": "72223333",
  "nombres": "Clon Cortazar",
  "edad": 72,
  "diagnostico": "Asma",
  "medicoAsignadoId": "{{medicoId}}"
}

###

# Intento de asignación de un médico inexistente en la base de datos
POST {{hostname}}/pacientes/registro
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "dni": "72223338",
  "nombres": "Paciente Fantasma",
  "edad": 45,
  "diagnostico": "Gripe",
  "medicoAsignadoId": "E6FFCE9B-89E2-4467-9DE8-000000000000"
}

###

# Intento de asignación de un enfermero como médico responsable
POST {{hostname}}/pacientes/registro
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "dni": "72223339",
  "nombres": "Paciente Sin Médico",
  "edad": 50,
  "diagnostico": "Fiebre",
  "medicoAsignadoId": "{{enfermeroId}}"
}


# =================================================================
# CU-05: Gestionar Paciente (Ficha y Umbrales Clínicos)
# =================================================================

### 5.1 Listar paciente como enfermero
GET {{hostname}}/pacientes/perfil/{{pacienteId}}
Authorization: Bearer {{tokenEnfermero}}

###

### 5.2 Listar paciente como administrador
GET {{hostname}}/pacientes/perfil/{{pacienteId}}
Authorization: Bearer {{tokenAdmin}}

###

### 5.3 Actualizar paciente como médico
PATCH {{hostname}}/pacientes/perfil/{{pacienteId}}
Content-Type: application/json
Authorization: Bearer {{tokenMedico}}

{
  "diagnostico": "Bronquitis Crónica bajo Monitoreo Continuo",
  "umbrales": [
    {
      "metricaId": "{{metricaId}}",
      "valorMin": 92.0,
      "valorMax": 98.0
    }
  ]
}

###

### 5.4 Gestiones de pacientes rechazadas (Validaciones)

# Actualizar paciente como enfermero (Falta de privilegios)
PATCH {{hostname}}/pacientes/perfil/{{pacienteId}}
Content-Type: application/json
Authorization: Bearer {{tokenEnfermero}}

{
  "diagnostico": "Actualización no autorizada"
}

###

# Umbrales fuera de los rangos biológicos del catálogo
PATCH {{hostname}}/pacientes/perfil/{{pacienteId}}
Content-Type: application/json
Authorization: Bearer {{tokenMedico}}

{
  "umbrales": [
    {
      "metricaId": "{{metricaId}}",
      "valorMin": 45.0,
      "valorMax": 110.0
    }
  ]
}

###

# Métricas duplicadas en la misma solicitud
PATCH {{hostname}}/pacientes/perfil/{{pacienteId}}
Content-Type: application/json
Authorization: Bearer {{tokenMedico}}

{
  "umbrales": [
    { "metricaId": "{{metricaId}}", "valorMin": 92.0, "valorMax": 95.0 },
    { "metricaId": "{{metricaId}}", "valorMin": 94.0, "valorMax": 98.0 }
  ]
}

###

# Diagnóstico compuesto únicamente de espacios en blanco
PATCH {{hostname}}/pacientes/perfil/{{pacienteId}}
Content-Type: application/json
Authorization: Bearer {{tokenMedico}}

{
  "diagnostico": "   "
}

###


# =================================================================
# CU-08: Ingestar Datos Biométricos & CU-09: Procesar Reglas
# =================================================================

### 8.1 Simular Ingesta IoT Directa al Backend - Lectura NORMAL
# Reemplace 'pacienteId' y 'metricaId' con UUIDs reales obtenidos del Dashboard o Catálogo.
POST {{hostname}}/ingesta
Content-Type: application/json

{
  "pacienteId": "remplace_con_uuid_de_paciente",
  "metricaId": "remplace_con_uuid_de_metrica",
  "valor": 75.0
}

###

### 8.2 Simular Ingesta IoT Directa al Backend - Lectura ADVERTENCIA (Fuera de Umbral)
POST {{hostname}}/ingesta
Content-Type: application/json

{
  "pacienteId": "remplace_con_uuid_de_paciente",
  "metricaId": "remplace_con_uuid_de_metrica",
  "valor": 93.0
}

###

### 8.3 Simular Ingesta IoT Directa al Backend - Lectura CRÍTICA (Dispara Alerta Crítica y Bloqueo en Frontend)
POST {{hostname}}/ingesta
Content-Type: application/json

{
  "pacienteId": "remplace_con_uuid_de_paciente",
  "metricaId": "remplace_con_uuid_de_metrica",
  "valor": 120.0
}

###

### 8.4 Ingestar a través de Azure Functions (Localhost Puerto 7071)
# Requiere haber iniciado la Azure Function mediante 'pnpm --filter ingesta-biometrica-function start'
POST http://localhost:7071/api/HttpTrigger
Content-Type: application/json

{
  "pacienteId": "remplace_con_uuid_de_paciente",
  "metricaId": "remplace_con_uuid_de_metrica",
  "valor": 120.0
}

###

### 8.5 Lectura con valor inválido
POST {{hostname}}/ingesta
Content-Type: application/json

{
  "pacienteId": "remplace_con_uuid_de_paciente",
  "metricaId": "remplace_con_uuid_de_metrica",
  "valor": -10
}

###

# ==============================================================================
# MÓDULO 03: CRUD DE CATÁLOGO DE MÉTRICAS Y UMBRALES (CASOS 13 AL 18)
# ==============================================================================

### Prueba 13 (INT-13): Crear Métrica Temperatura Corporal en Catálogo
# Salida esperada: HTTP 201 Created (Rango normal: 36.0 - 37.5 °C)
# @name caso13
POST {{hostname}}/metricas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "nombre": "Temperatura Corporal",
  "unidad": "°C",
  "descripcion": "Temperatura corporal del paciente",
  "rangoMin": 36.0,
  "rangoMax": 37.5
}

### Prueba 14 (INT-14): Crear Métrica Frecuencia Cardíaca
# Salida esperada: HTTP 201 Created (Rango normal: 60.0 - 100.0 bpm)
POST {{hostname}}/metricas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "nombre": "Frecuencia Cardíaca",
  "unidad": "bpm",
  "descripcion": "Pulsaciones por minuto",
  "rangoMin": 60.0,
  "rangoMax": 100.0
}

### Prueba 15 (INT-15): Crear Métrica Saturación de Oxígeno (SpO2)
# Salida esperada: HTTP 201 Created (Rango normal: 95.0 - 100.0 %)
POST {{hostname}}/metricas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "nombre": "Saturación de Oxígeno",
  "unidad": "%",
  "descripcion": "Porcentaje de saturación SpO2 por oxímetro de pulso",
  "rangoMin": 95.0,
  "rangoMax": 100.0
}

### Prueba 16 (INT-16): Bloqueo por Incoherencia Numérica (Min >= Max)
# Entrada: rangoMin: 100.0, rangoMax: 60.0 (Violación RNF-11)
# Salida esperada: HTTP 400 Bad Request ("El rango máximo debe ser mayor al mínimo")
POST {{hostname}}/metricas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "nombre": "Presión Sistólica Error",
  "unidad": "mmHg",
  "rangoMin": 140.0,
  "rangoMax": 90.0
}

### Prueba 17 (INT-17): Rechazo por Rango Mínimo Negativo
# Entrada: rangoMin: -5.0
# Salida esperada: HTTP 400 Bad Request ("El rango mínimo debe ser positivo")
POST {{hostname}}/metricas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "nombre": "Temperatura Invalida Negativa",
  "unidad": "°C",
  "rangoMin": -5.0,
  "rangoMax": 40.0
}

### Prueba 18 (INT-18): Rechazo por Falta de Privilegios (Médico Intenta Crear Métrica)
# Entrada: Petición con Token de Médico tratante
# Salida esperada: HTTP 403 Forbidden ("Acceso no autorizado")
POST {{hostname}}/metricas
Content-Type: application/json
Authorization: Bearer {{loginMedico.response.body.token}}

{
  "nombre": "Métrica No Autorizada",
  "unidad": "mg/dL",
  "rangoMin": 70.0,
  "rangoMax": 110.0
}


# ==============================================================================
# MÓDULO 04: CRUD DE TELEMETRÍA IOT Y ALERTAS CLÍNICAS (CASOS 19 AL 24)
# ==============================================================================

### Prueba 19 (INT-19): Ingesta Telemétrica NORMAL (Color Verde)
# Entrada: 36.6 °C (dentro de 36.0 y 37.5)
# Salida esperada: HTTP 201 Created (Severidad: NORMAL, sin alerta)
POST {{hostname}}/ingesta
Content-Type: application/json

{
  "pacienteId": "{{caso07.response.body.id}}",
  "metricaId": "{{caso13.response.body.id}}",
  "valor": 36.6
}

### Prueba 20 (INT-20): Ingesta Telemétrica con Desvío Leve -> ADVERTENCIA (Color Amarillo)
# Entrada: 37.9 °C (desvío leve <= 10%)
# Salida esperada: HTTP 201 Created (Severidad: ADVERTENCIA)
POST {{hostname}}/ingesta
Content-Type: application/json

{
  "pacienteId": "{{caso07.response.body.id}}",
  "metricaId": "{{caso13.response.body.id}}",
  "valor": 37.9
}

### Prueba 21 (INT-21): Ingesta Telemétrica Severa -> CRÍTICO (Color Rojo + Alerta)
# Entrada: 39.4 °C (Fiebre severa > 10% desvío)
# Salida esperada: HTTP 201 Created (Severidad: CRITICO, dispara alerta en tiempo real)
# @name caso21
POST {{hostname}}/ingesta
Content-Type: application/json

{
  "pacienteId": "{{caso07.response.body.id}}",
  "metricaId": "{{caso13.response.body.id}}",
  "valor": 39.4
}

### Prueba 22 (INT-22): Descarte de Paquete de Paciente Inexistente (RF-10)
# Entrada: UUID de paciente inexistente
# Salida esperada: HTTP 400 Bad Request ("El paciente especificado no existe.")
POST {{hostname}}/ingesta
Content-Type: application/json

{
  "pacienteId": "b0000000-0000-0000-0000-000000000000",
  "metricaId": "{{caso13.response.body.id}}",
  "valor": 38.0
}

### Prueba 23 (INT-23): Descarte por Métrica No Existente en Catálogo
# Entrada: UUID de métrica inexistente
# Salida esperada: HTTP 400 Bad Request ("La métrica especificada no existe.")
POST {{hostname}}/ingesta
Content-Type: application/json

{
  "pacienteId": "{{caso07.response.body.id}}",
  "metricaId": "c0000000-0000-0000-0000-000000000000",
  "valor": 38.5
}

### Prueba 24 (INT-24): Atender Alerta Médica Crítica (CU-07)
# Salida esperada: HTTP 200 OK ("Alerta gestionada exitosamente")
POST {{hostname}}/alertas/{{caso21.response.body.alerta.id}}/atender
Content-Type: application/json
Authorization: Bearer {{loginMedico.response.body.token}}

{
  "medicoId": "{{loginMedico.response.body.usuario.id}}",
  "resumen": "Paciente contactado telefónicamente. Se prescribe antipirético y control en 2 horas.",
  "recomendaciones": "Monitoreo continuo de temperatura y baño tibio asistido."
}

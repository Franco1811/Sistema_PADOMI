# ==============================================================================
# SISTEMA DE TELEMETRÍA Y GESTIÓN DE ALERTAS (PADOMI - ESSALUD)
# BATERÍA DE PRUEBAS DE INTEGRACIÓN - SEMANA 10 (24 CASOS FORMALES)
# ==============================================================================
# Instrucciones:
# 1. Ejecuta primero las peticiones 0.1 y 0.2 (Login) para generar los tokens JWT.
# 2. Las siguientes peticiones consumen dinámicamente el token correspondiente
#    mediante las variables {{loginAdmin.response.body.token}} y {{loginMedico.response.body.token}}.
# 3. Cada caso corresponde exactamente a los IDs 1 al 24 de la Semana 09.
# ==============================================================================

@hostname = http://localhost:3000/api

# Identificadores de soporte generados automáticamente o preconfigurados:
@adminRaizId = d0a4d592-ee4f-4c23-9d27-7b1a53e4a28a
@medicoRaizId = 99999999-9999-9999-9999-999999999999


# ==============================================================================
# PASO 0: AUTENTICACIÓN (GENERACIÓN DE TOKENS JWT)
# ==============================================================================

### 0.1 Iniciar Sesión como Administrador
# @name loginAdmin
POST {{hostname}}/auth/login
Content-Type: application/json

{
  "email": "admin.padomi@essalud.gob.pe",
  "password": "admin_secreto"
}

### 0.2 Iniciar Sesión como Médico Tratante
# @name loginMedico
POST {{hostname}}/auth/login
Content-Type: application/json

{
  "email": "carlos.mendoza@essalud.gob.pe",
  "password": "carlos_secreto"
}


# ==============================================================================
# MÓDULO 01: CRUD DE PERSONAL MÉDICO Y ADMINISTRATIVO (CASOS 1 AL 6)
# ==============================================================================

### Prueba 01 (INT-01): Registrar Personal Médico Válido (Flujo Feliz)
# Salida esperada: HTTP 201 Created (Genera código correlativo USU-XXXX)
# @name caso01
POST {{hostname}}/personal
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "dni": "70415264",
  "nombre": "Franco Emerson",
  "apellido": "Gonzalez Poma",
  "email": "franco.gonzalez@essalud.gob.pe",
  "password": "Medico2026@!",
  "rol": "MEDICO",
  "especialidad": "Geriatría"
}

### Prueba 02 (INT-02): Registrar Administrador Válido (Sin Especialidad)
# Salida esperada: HTTP 201 Created (Admin creado sin requerir especialidad)
POST {{hostname}}/personal
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "dni": "72839402",
  "nombre": "Nicole Darlene",
  "apellido": "Tito Huacho",
  "email": "nicole.tito@essalud.gob.pe",
  "password": "Admin2026@Root!",
  "rol": "ADMIN"
}

### Prueba 03 (INT-03): Registrar Médico con Otra Especialidad (Cardiología)
